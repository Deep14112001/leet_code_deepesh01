class Solution {
public:
    int jump(vector<int>& nums) {
        if(nums.size()==1) return 0;
        int highpos=0;
        int pos=nums[0];
        int count=0;
        int i=0;
        while(1){
            while(i<nums.size()-1){
                if(highpos<i+nums[i]) highpos=i+nums[i];
                if(i==pos) break;
                i++;
            }
            pos=highpos;
            count++;
            if(i==nums.size()-1) return count;
        }
    }
};
